# ComfyUI server running locally or on a trusted private network.
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Checkpoint filename installed under ComfyUI/models/checkpoints.
COMFYUI_CHECKPOINT=Realistic_Vision_V6.0_NV_B1_fp16.safetensors
# Maximum time to wait for an image-generation workflow.
COMFYUI_TIMEOUT_SECONDS=300

# Pollinations online image generation. Create a key at https://enter.pollinations.ai
# Keep this key on the server; it is never sent to the browser.
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell

# Optional social publishing. Generate a private Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key separate from the database and back it up; changing it makes
# previously encrypted provider tokens unreadable.
QURAN_REELS_SECRET_KEY=
QURAN_REELS_TOKEN_ENCRYPTION_KEY=
QURAN_REELS_PUBLISHER_DB=instance/publisher.sqlite3
# Set to 1 when serving the app over HTTPS; leave 0 for localhost development.
QURAN_REELS_COOKIE_SECURE=0

# Google Cloud OAuth web client for YouTube Data API v3.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://your-domain.example/oauth/youtube/callback
YOUTUBE_DEFAULT_CATEGORY_ID=10

# TikTok Login Kit and Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/oauth/tiktok/callback
# Keep disabled until TikTok approves video.publish and the app's Direct Post configuration.
TIKTOK_DIRECT_POST_ENABLED=0
